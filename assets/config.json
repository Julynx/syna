{
  "timeout_ms": 120000,
  "retry": {
    "strategy": "backoff",
    "initial_interval_ms": 1000,
    "max_interval_ms": 10000,
    "exponent": 1.5,
    "max_elapsed_time_ms": 30000,
    "retry_connection_errors": false
  },
  "max_command_output_chars": 40000,
  "max_output_tokens": 16384,
  "tool_call_timeout_s": 60,
  "command_timeout_s": 50,
  "max_steps_per_turn": 100,
  "step_warning_remaining": 20,
  "max_history_messages": 100,
  "enable_compaction": true,
  "max_visible_tool_calls": 3,
  "log_file": "syna.log",
  "session_dump_file": "message-session-log.json",
  "server_host": "127.0.0.1",
  "server_port": 8000,
  "session_idle_timeout_min": 15,
  "upload_dest": "/home/user/uploads",
  "voice": {
    "voice_mode_on": false,
    "silence_timeout_ms": 2000,
    "silence_threshold_dbfs": -45,
    "max_recording_ms": 60000
  }
}